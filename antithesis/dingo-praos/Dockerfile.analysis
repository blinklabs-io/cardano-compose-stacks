FROM ghcr.io/blinklabs-io/go:1.27.3-1 AS build
WORKDIR /code
RUN go env -w GOCACHE=/go-cache && go env -w GOMODCACHE=/gomod-cache
COPY go.* ./
RUN --mount=type=cache,target=/gomod-cache go mod download
COPY . .
RUN --mount=type=cache,target=/gomod-cache --mount=type=cache,target=/go-cache \
    go build -tags antithesis -o /code/analysis ./cmd/analysis/

FROM debian:bookworm-20260918-slim
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 -m analysis
COPY --from=build /code/analysis /bin/analysis
# Antithesis runs test commands from this directory with `docker exec`; the
# analysis daemon is the container's main process, so it stays up for them.
COPY --chmod=0755 composer/dingo-praos/eventually_converged.sh /opt/antithesis/test/v1/dingo-praos/eventually_converged.sh
USER analysis
ENTRYPOINT ["/bin/analysis"]
